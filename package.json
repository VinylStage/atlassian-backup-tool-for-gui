    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "marked-highlight": "^2.2.4",
    "postcss": "^8.5.30",
    "puppeteer": "^25.13.0",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "github-markdown-css": "^5.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "puppeteer@25.13.0": true,
    "esbuild@0.28.2": true
