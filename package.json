{
  "name": "atlassian-backup-tool-gui",
  "version": "1.1.1",
  "description": "Confluence Cloud backup tool with React web UI",
  "license": "MIT",
  "author": "VinylStage",
  "repository": {
    "type": "git",
    "url": "https://github.com/VinylStage/atlassian-backup-tool-for-gui.git"
  },
